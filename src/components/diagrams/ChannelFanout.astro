---
interface Props {
  /** Seconds for one full pass. */
  cycle?: number;
}

/**
 * WizLane communications fan-out — "every alert, every channel, automatically".
 *
 * One event (a delivery is completed) fans out to three channels at once: SMS,
 * WhatsApp and Email. The animation fires each channel in turn from the single
 * event, which says "one thing happens, everyone who needs to know is told"
 * faster than a sentence does. WhatsApp carries its real behaviour — an
 * automatic SMS fallback if delivery fails.
 *
 * All three channels are wired in the product, so nothing here is aspirational.
 * Complete and readable when static (the event and all three channels are
 * labelled); the motion only stages the fan-out. Nothing animates under
 * prefers-reduced-motion. A .sr-only caption narrates it.
 */
const { cycle = 6 } = Astro.props as Props;

const channels = [
  { key: 'sms', label: 'SMS', note: 'AfricasTalking' },
  { key: 'whatsapp', label: 'WhatsApp', note: '→ SMS fallback' },
  { key: 'email', label: 'Email', note: 'with the ePOD attached' },
];
---

<figure class="fan" style={`--cycle:${cycle}s`}>
  <figcaption class="sr-only">
    When a delivery is completed, WizLane notifies everyone who needs to know
    across three channels at once — SMS, WhatsApp and email — automatically. If
    a WhatsApp message fails to deliver, it falls back to SMS.
  </figcaption>

  <div class="event" aria-hidden="true">
    <span class="event-tag">Event</span>
    <span class="event-name">Delivery completed</span>
  </div>

  <span class="spine" aria-hidden="true"></span>

  <div class="channels">
    {
      channels.map((c, i) => (
        <div class={`chan chan--${c.key}`} style={`--i:${i}`} aria-hidden="true">
          <span class="chan-stub" />
          <span class="chan-label">{c.label}</span>
          <span class="chan-note">{c.note}</span>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .fan {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.75rem 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-grey-100);
    background: var(--color-paper);
  }

  .event {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    width: min(18rem, 100%);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-navy-700);
    text-align: center;
  }

  .event-tag {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy-100);
  }

  .event-name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-paper);
  }

  /* A pulse that rides down the spine on each cycle. Static: a plain rule. */
  .spine {
    position: relative;
    width: 2px;
    height: 1.35rem;
    border-radius: 1px;
    background: var(--color-grey-300);
    overflow: hidden;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    max-width: 30rem;
  }

  .chan {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.85rem 0.6rem 0.75rem;
    text-align: center;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-grey-100);
    background: var(--color-warm);
    /* Base (and reduced-motion) state: all three shown, neutral. */
    transition: border-color 200ms var(--ease-standard);
  }

  /* Short stub joining each channel up toward the spine. */
  .chan-stub {
    position: absolute;
    top: -0.6rem;
    left: calc(50% - 1px);
    width: 2px;
    height: 0.6rem;
    background: var(--color-grey-300);
    border-radius: 1px;
  }

  .chan-label {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy-700);
    line-height: 1.2;
  }

  .chan-note {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    line-height: 1.3;
  }

  /* ---- motion: the event pulses, then each channel fires in turn --------
     Everything above is complete and legible with no animation. */
  @media (prefers-reduced-motion: no-preference) {
    .event {
      animation: event-pulse var(--cycle) ease-in-out infinite;
    }

    .spine::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--color-orange-500);
      transform: translateY(-100%);
      animation: spine-run var(--cycle) ease-in infinite;
    }

    .chan {
      animation: chan-fire var(--cycle) ease-in-out infinite;
      /* Fan out left-to-right, just after the pulse reaches the row. */
      animation-delay: calc(0.9s + var(--i) * 0.35s);
    }
  }

  @keyframes event-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(247, 157, 7, 0);
    }
    6% {
      box-shadow: 0 0 0 4px rgba(247, 157, 7, 0.35);
    }
    18% {
      box-shadow: 0 0 0 0 rgba(247, 157, 7, 0);
    }
  }

  @keyframes spine-run {
    0% {
      transform: translateY(-100%);
    }
    14%,
    100% {
      transform: translateY(100%);
    }
  }

  @keyframes chan-fire {
    0%,
    8% {
      border-color: var(--color-grey-100);
      background: var(--color-warm);
    }
    16%,
    46% {
      border-color: var(--color-orange-500);
      background: var(--color-orange-100);
    }
    60%,
    100% {
      border-color: var(--color-grey-100);
      background: var(--color-warm);
    }
  }

  @media (max-width: 26rem) {
    .channels {
      grid-template-columns: 1fr;
      max-width: 16rem;
      gap: 1rem;
    }

    /* Once stacked, the stubs would point at nothing — hide them. */
    .chan-stub {
      display: none;
    }
  }
</style>
