---
import type { Post } from '../../lib/insights';
import { formatDate, readingMinutes } from '../../lib/insights';

/**
 * One post card, used by the index, pagination and taxonomy pages. The whole
 * card is a single link, so the category stays plain text here (a nested link
 * would be invalid) — category/tag links live on the article page instead.
 */
interface Props {
  post: Post;
  /** Position in its grid, for the staggered scroll reveal. */
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { data } = post;
---

<article data-reveal data-reveal-delay={String(Math.min(index, 3) * 70)}>
  <a href={`/insights/${post.id}`} class="group block">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium">
      <span class="text-orange-700">{data.category}</span>
      <span class="text-grey-500" aria-hidden="true">·</span>
      <time class="text-ink-soft" datetime={data.publishDate.toISOString()}>
        {formatDate(data.publishDate)}
      </time>
      <span class="text-grey-500" aria-hidden="true">·</span>
      <span class="text-ink-soft">{readingMinutes(post.body)} min read</span>
      {
        data.draft && (
          <span class="rounded-[var(--radius-sm)] bg-orange-100 px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-[0.08em] text-orange-700">
            Draft
          </span>
        )
      }
    </div>
    <h2 class="mt-3 text-[length:var(--text-3xl)] leading-snug text-navy-700 transition-colors group-hover:text-orange-700">
      {data.title}
    </h2>
    <p class="mt-2.5 max-w-[52ch] text-base leading-relaxed text-ink">{data.description}</p>
  </a>
</article>
