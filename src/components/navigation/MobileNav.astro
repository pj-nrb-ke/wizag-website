---
import Icon from '../ui/Icon.astro';

/**
 * Mobile / tablet nav — the toggle button only. It lives in the header bar.
 *
 * The drawer + backdrop it controls are rendered separately in
 * MobileDrawer.astro at body level (see the comment there: a fixed drawer
 * nested inside the `backdrop-blur` header gets clamped to the header's
 * height). Header.astro wires this button to the drawer by data-attribute.
 *
 * Shown below the custom `nav` breakpoint; above it the full DesktopNav shows.
 */
---

<button
  type="button"
  class="-mr-2 flex items-center justify-center rounded-[var(--radius-sm)] p-2.5 text-navy-700
         transition-colors duration-[var(--duration-fast)] hover:bg-navy-50 nav:hidden"
  aria-expanded="false"
  aria-controls="mobile-drawer"
  aria-label="Open menu"
  data-drawer-toggle
>
  <Icon name="menu" size={20} />
</button>
