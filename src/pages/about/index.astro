---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import ImageSlot from '../../components/ui/ImageSlot.astro';
import { story, namePoint, principles, pillars, boundary, aboutImages } from '../../data/about';
import { about, company } from '../../data/navigation';

/**
 * Company overview — curated 2026-07-23.
 *
 * The page carries the firm's identity, not a second copy of the homepage.
 * It leads with who WIZAG is and what it deliberately is not, states how it
 * works at essay length, shows the "one partner" structure, and names the
 * clients it is NOT the right firm for — which on an advisory site is the
 * most credible thing on the page.
 *
 * No founding year, headcount, client or leadership claims: see the header
 * of src/data/about.ts for the full list of what is withheld and why. When
 * the client supplies real facts they slot into that file.
 */
const sub = about.filter((item) => item.href !== '/about');
const { address } = company;
const approach = aboutImages.approach;
const office = aboutImages.office;
---

<BaseLayout
  title="About WIZAG"
  description="Wise & Agile Solutions Ltd is an enterprise transformation and technology services company in Nairobi — a services firm, deliberately not a software vendor or reseller."
>
  <PageHero
    title="More than a technology vendor"
    lead="WIZAG is an enterprise transformation and technology services company in Nairobi. We are engaged to understand the operating problem first — and to recommend the smallest change that solves it, whether or not that change is something we sell."
    eyebrow="About WIZAG"
    crumbs={[{ label: 'Home', href: '/' }]}
  />

  <!-- WHO WE ARE ------------------------------------------------------- -->
  <Section tone="paper">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div data-reveal>
        <SectionHeading eyebrow="Who we are" measure="max-w-[15ch]">
          A services firm, on purpose
        </SectionHeading>
        <div class="mt-6">
          {
            story.map((paragraph, i) => (
              <p
                class:list={[
                  'max-w-[60ch] text-[length:var(--text-lg)] leading-relaxed text-ink',
                  i > 0 && 'mt-5',
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>

      <div class="lg:pt-16" data-reveal data-reveal-delay="120">
        {
          approach.file ? (
            <img
              src={`/images/about/${approach.file}`}
              alt={approach.alt}
              width={approach.w}
              height={approach.h}
              loading="lazy"
              decoding="async"
              class="w-full rounded-[var(--radius-md)] object-cover"
            />
          ) : (
            <ImageSlot ratio="4/3" brief={approach.brief} purpose={approach.purpose} />
          )
        }

        <p class="mt-6 border-l-2 border-orange-500 pl-5 text-base leading-relaxed text-ink-soft">
          {namePoint}
        </p>
      </div>
    </div>
  </Section>

  <!-- WHAT WE BELIEVE -------------------------------------------------- -->
  <Section tone="warm">
    <SectionHeading
      eyebrow="How we work"
      lead="Four convictions that decide how an engagement is scoped, staffed and priced. They are easy to claim and harder to hold to, so they are written plainly enough to be held to."
      measure="max-w-[16ch]"
      class="max-w-3xl"
      data-reveal
    >
      What we believe
    </SectionHeading>

    <div class="mt-12 grid gap-x-14 gap-y-10 lg:grid-cols-2">
      {
        principles.map((principle, i) => (
          <div
            class="border-t border-grey-300 pt-6"
            data-reveal
            data-reveal-delay={String(Math.min(i, 3) * 70)}
          >
            <Icon name={principle.icon} size={26} class="text-orange-500" />
            <h3 class="mt-4 text-[length:var(--text-2xl)] leading-snug text-navy-700">
              {principle.title}
            </h3>
            <p class="mt-3 max-w-[52ch] text-base leading-relaxed text-ink">{principle.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ONE PARTNER ------------------------------------------------------ -->
  <Section tone="paper">
    <SectionHeading
      eyebrow="One partner, end to end"
      lead="Most organisations buy these three things from three different places. WIZAG brings them under one relationship — which is the whole point of the name."
      measure="max-w-[18ch]"
      class="max-w-3xl"
      data-reveal
    >
      Decide, build, run
    </SectionHeading>

    <ol class="mt-12 grid gap-x-12 gap-y-10 lg:grid-cols-3">
      {
        pillars.map((pillar, i) => (
          <li
            class="relative border-t-2 border-navy-700 pt-6"
            data-reveal
            data-reveal-delay={String(i * 90)}
          >
            <div class="flex items-center gap-3">
              <Icon name={pillar.icon} size={24} class="text-orange-500" />
              <span class="font-mono text-xs font-bold tracking-[0.14em] text-orange-700">
                {pillar.step}
              </span>
            </div>

            <h3 class="mt-4 text-[length:var(--text-3xl)] leading-tight text-navy-700">
              {pillar.name}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink">{pillar.body}</p>

            <a
              href={pillar.href}
              class="group mt-5 inline-flex items-center gap-1.5 text-base font-semibold text-navy-700 transition-colors duration-[var(--duration-fast)] hover:text-orange-700"
            >
              {pillar.linkLabel}
              <Icon
                name="arrow-right"
                size={16}
                class="shrink-0 transition-transform duration-[var(--duration-fast)] motion-safe:group-hover:translate-x-0.5"
              />
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- THE HONEST BOUNDARY ---------------------------------------------- -->
  <Section tone="deep" space="tight">
    <div class="mx-auto max-w-[68ch] text-center" data-reveal>
      <p class="eyebrow mb-4 text-orange-500">Who we are not for</p>
      <p class="text-[length:var(--text-2xl)] leading-[1.5] text-paper">
        {boundary}
      </p>
    </div>
  </Section>

  <!-- WHERE WE ARE ----------------------------------------------------- -->
  <Section tone="paper">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div data-reveal>
        <SectionHeading eyebrow="Where we are" measure="max-w-[15ch]">
          Based in Nairobi, working across the region
        </SectionHeading>

        <address class="mt-8 space-y-1 text-[length:var(--text-lg)] not-italic leading-relaxed text-ink">
          <div class="font-semibold text-navy-700">{address.building}</div>
          <div>{address.unit}</div>
          <div>{address.street}</div>
          <div>{address.area}, {address.city}</div>
          <div>{address.country}</div>
        </address>

        <a
          href={`mailto:${company.email}`}
          class="mt-6 inline-flex items-center gap-2 py-1 text-[length:var(--text-lg)] font-semibold text-navy-700 transition-colors duration-[var(--duration-fast)] hover:text-orange-700"
        >
          <Icon name="mail" size={16} />
          {company.email}
        </a>

        <div class="mt-10">
          <p class="eyebrow mb-4 text-ink-soft">More about WIZAG</p>
          <ul>
            {
              sub.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center justify-between gap-4 border-t border-grey-300 py-4 text-[length:var(--text-xl)] font-semibold text-navy-700 transition-colors duration-[var(--duration-fast)] hover:text-orange-700"
                  >
                    {item.label}
                    <Icon
                      name="arrow-right"
                      size={16}
                      class="shrink-0 text-grey-500 transition-all duration-[var(--duration-fast)] group-hover:text-orange-700 motion-safe:group-hover:translate-x-0.5"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:pt-4" data-reveal data-reveal-delay="120">
        {
          office.file ? (
            <img
              src={`/images/about/${office.file}`}
              alt={office.alt}
              width={office.w}
              height={office.h}
              loading="lazy"
              decoding="async"
              class="w-full rounded-[var(--radius-md)] object-cover"
            />
          ) : (
            <ImageSlot ratio="4/3" brief={office.brief} purpose={office.purpose} />
          )
        }
      </div>
    </div>
  </Section>

  <!-- CTA -------------------------------------------------------------- -->
  <Section tone="deep" space="tight">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-[length:var(--text-3xl)] text-paper">Let's talk about your operation</h2>
        <p class="mt-3 max-w-[52ch] text-base text-navy-100">
          A short, structured conversation about where technology is helping and where it is
          getting in the way — with a plain answer on whether we are the right people for it.
        </p>
      </div>
      <Button href="/contact" variant="inverse" size="large" arrow>Book an Assessment</Button>
    </div>
  </Section>
</BaseLayout>
