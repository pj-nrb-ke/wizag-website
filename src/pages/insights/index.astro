---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import PostCard from '../../components/insights/PostCard.astro';
import Pagination from '../../components/insights/Pagination.astro';
import { getPublishedPosts, collectTerms, PAGE_SIZE } from '../../lib/insights';

/**
 * Insights index — page one. Dormant by design: `noindex`, out of the sitemap
 * and unlinked from the nav until real articles exist (brief §8.12). Drafts
 * show in dev only. Pages two onward live at /insights/page/N.
 */
const posts = await getPublishedPosts();
const categories = collectTerms(posts, 'category');
const pagePosts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<BaseLayout
  title="Insights — WIZAG"
  description="Perspectives on enterprise transformation, ERP, AI and operational excellence from Wise & Agile Solutions."
  noindex
>
  <section class="border-b border-grey-100 bg-warm">
    <Container class="py-12 md:py-16">
      <p class="eyebrow text-orange-700">Insights</p>
      <h1 class="optical-left mt-4 max-w-[18ch] text-[length:var(--text-5xl)] leading-[1.1] text-navy-700">
        Ideas on making technology serve the business
      </h1>
      <p class="mt-5 max-w-[54ch] text-[length:var(--text-lg)] leading-relaxed text-ink">
        Practical perspectives on enterprise transformation, ERP, AI and operational
        excellence — written from the work, not the brochure.
      </p>
    </Container>
  </section>

  <Section tone="paper">
    {
      posts.length === 0 ? (
        <div class="mx-auto max-w-[44ch] py-16 text-center">
          <h2 class="text-[length:var(--text-2xl)] leading-snug text-navy-700">
            Articles are on the way
          </h2>
          <p class="mt-3 text-ink-soft">
            We are preparing the first pieces. In the meantime, explore how we work.
          </p>
          <a
            href="/services"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-navy-700 transition-colors hover:text-orange-700"
          >
            Explore our capabilities →
          </a>
        </div>
      ) : (
        <>
          {categories.length > 1 && (
            <div class="mb-10 flex flex-wrap items-center gap-2">
              <span class="mr-1 text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">
                Topics
              </span>
              {categories.map((c) => (
                <a
                  href={`/insights/category/${c.slug}`}
                  class="rounded-full border border-grey-100 px-3 py-1 text-sm text-navy-700 transition-colors hover:border-navy-300 hover:text-orange-700"
                >
                  {c.name} <span class="text-ink-soft">{c.count}</span>
                </a>
              ))}
              <a
                href="/rss.xml"
                class="ml-auto inline-flex items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-orange-700"
              >
                RSS feed →
              </a>
            </div>
          )}

          <div class="grid gap-x-10 gap-y-12 lg:grid-cols-2">
            {pagePosts.map((post, i) => (
              <PostCard post={post} index={i} />
            ))}
          </div>

          <Pagination current={1} total={totalPages} />
        </>
      )
    }
  </Section>
</BaseLayout>
