---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import CmsImage from '../../components/ui/CmsImage.astro';
import { getPosts, mediaUrl, formatPostDate, postExcerpt, readingMinutes, type PayloadPost } from '../../lib/payload';
import { lexicalToHtml } from '../../lib/lexical';

/**
 * A single Insights article. Paths are generated at build time from the posts
 * published in Payload (see src/lib/payload.ts). The Lexical rich-text body is
 * rendered to HTML by src/lib/lexical.ts.
 *
 * Named routes win over this dynamic one, so nothing else lives under
 * /insights/* — no exclusions are needed here.
 */
export async function getStaticPaths() {
  const posts = await getPosts();
  const seen = new Set<string>();
  return posts
    .filter((post) => {
      if (seen.has(post.slug)) return false; // slugs are unique in the CMS; guard anyway
      seen.add(post.slug);
      return true;
    })
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: PayloadPost;
}

const { post } = Astro.props;

const hero = mediaUrl(post.heroImage);
const bodyHtml = lexicalToHtml(post.content, { stripLeadingTitle: post.title });
const dateLabel = formatPostDate(post);
const meta = [dateLabel, `${readingMinutes(post)} min read`].filter(Boolean).join('  ·  ');
const excerpt = postExcerpt(post);
const heroAlt = post.heroImage?.alt || post.title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://wizag.biz').href;

/* BlogPosting structured data — lets search engines present the post as an
   article (headline, image, date, author) and can qualify it for rich
   results. Built only from the post's own verified fields. */
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: excerpt,
  ...(hero ? { image: [hero] } : {}),
  datePublished: post.publishedDate ?? post.createdAt,
  dateModified: post.updatedAt ?? post.publishedDate ?? post.createdAt,
  author: { '@type': 'Organization', name: post.author || 'WIZAG', url: 'https://wizag.biz/' },
  publisher: {
    '@type': 'Organization',
    name: 'Wise & Agile Solutions Ltd',
    logo: { '@type': 'ImageObject', url: 'https://wizag.biz/brand/wizag-logo.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  ...(post.category?.title ? { articleSection: post.category.title } : {}),
  ...(post.tags && post.tags.length ? { keywords: post.tags.join(', ') } : {}),
};
---

<BaseLayout
  title={post.title}
  description={excerpt}
  ogType="article"
  ogImage={hero ?? undefined}
  ogImageWidth={post.heroImage?.width ?? undefined}
  ogImageHeight={post.heroImage?.height ?? undefined}
  ogImageAlt={heroAlt}
>
  {/* Article structured data (JSON-LD). Valid in the body per Google. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <!-- ARTICLE HEADER -------------------------------------------------- -->
  <header class="border-b border-grey-100 bg-warm">
    <Container class="py-10 md:py-12 lg:py-14">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
          <li class="flex items-center gap-2">
            <a href="/" class="py-1 transition-colors duration-[var(--duration-fast)] hover:text-navy-700">Home</a>
            <Icon name="chevron-down" size={13} class="-rotate-90 text-grey-500" />
          </li>
          <li class="flex items-center gap-2">
            <a href="/insights" class="py-1 transition-colors duration-[var(--duration-fast)] hover:text-navy-700">Insights</a>
            <Icon name="chevron-down" size={13} class="-rotate-90 text-grey-500" />
          </li>
          <li aria-current="page" class="py-1 font-semibold text-navy-700 truncate max-w-[24ch]">{post.title}</li>
        </ol>
      </nav>

      <p class="eyebrow mb-4 text-orange-700">{post.category?.title ?? 'Article'}</p>

      <h1 class="optical-left max-w-[24ch] text-[length:var(--text-5xl)] leading-[1.1] text-navy-700">
        {post.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
        {post.author && <span class="font-semibold text-ink">By {post.author}</span>}
        {post.author && meta && <span aria-hidden="true" class="text-grey-500">·</span>}
        {meta && <span>{meta}</span>}
      </div>
    </Container>
  </header>

  <!-- BODY — hero image + article share one reading column, so a large hero
       sits at a comfortable size instead of dominating the page. --------- -->
  <Section tone="paper" width="narrow" space="base">
    {
      hero && (
        <figure class="mb-10 overflow-hidden rounded-[var(--radius-lg)] bg-warm md:mb-12">
          <CmsImage
            media={post.heroImage}
            alt={heroAlt}
            maxWidth={1200}
            sizes="(min-width: 48rem) 720px, 100vw"
            class="h-auto w-full"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <article class="insights-prose" set:html={bodyHtml} />

    {
      post.tags && post.tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <li class="rounded-[var(--radius-sm)] border border-grey-100 bg-warm px-3 py-1 text-sm text-ink-soft">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-12 border-t border-grey-100 pt-8">
      <a
        href="/insights"
        class="group inline-flex items-center gap-2 text-base font-semibold text-navy-700 transition-colors duration-[var(--duration-fast)] hover:text-orange-700"
      >
        <Icon name="arrow-right" size={16} class="rotate-180 transition-transform duration-[var(--duration-fast)] motion-safe:group-hover:-translate-x-0.5" />
        All Insights
      </a>
    </div>
  </Section>

  <!-- CTA ------------------------------------------------------------- -->
  <Section tone="deep" space="tight">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-[length:var(--text-3xl)] text-paper">Facing a decision like this in your business?</h2>
        <p class="mt-3 max-w-[54ch] text-base text-navy-100">
          We start with the operating problem, not the software. If a topic here reflects something you are
          working through, we would be glad to talk it over.
        </p>
      </div>
      <Button href="/contact" variant="inverse" size="large" arrow>Book an Assessment</Button>
    </div>
  </Section>
</BaseLayout>

<!-- Prose styling. `is:global` (scoped under .insights-prose) because the body
     is injected via set:html — Astro's scoped-style attributes never land on
     set:html content, so a normal scoped rule would silently match nothing. -->
<style is:global>
  .insights-prose {
    color: var(--color-ink);
    font-size: var(--text-lg);
    line-height: 1.75;
    max-width: 68ch;
  }

  .insights-prose > * + * {
    margin-top: 1.25em;
  }

  .insights-prose h2,
  .insights-prose h3 {
    font-family: var(--font-serif);
    color: var(--color-navy-700);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .insights-prose h2 {
    font-size: var(--text-3xl);
    margin-top: 2em;
  }

  .insights-prose h3 {
    font-size: var(--text-2xl);
    margin-top: 1.6em;
  }

  /* Tighten the gap between a heading and the paragraph it introduces. */
  .insights-prose h2 + *,
  .insights-prose h3 + * {
    margin-top: 0.6em;
  }

  .insights-prose strong {
    color: var(--color-navy-800);
    font-weight: 650;
  }

  .insights-prose a {
    color: var(--color-navy-700);
    text-decoration: underline;
    text-decoration-color: var(--color-orange-300);
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .insights-prose a:hover {
    color: var(--color-orange-700);
    text-decoration-color: currentColor;
  }

  .insights-prose ul,
  .insights-prose ol {
    padding-left: 1.4em;
  }

  .insights-prose ul > li {
    list-style: disc;
  }

  .insights-prose ol > li {
    list-style: decimal;
  }

  .insights-prose li + li {
    margin-top: 0.4em;
  }

  .insights-prose li::marker {
    color: var(--color-orange-500);
  }

  .insights-prose blockquote {
    border-left: 2px solid var(--color-orange-500);
    padding-left: 1.25rem;
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--color-navy-800);
  }

  .insights-prose figure {
    margin-top: 2em;
    margin-bottom: 2em;
  }

  .insights-prose img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .insights-prose figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .insights-prose hr {
    border: 0;
    border-top: 1px solid var(--color-grey-100);
    margin: 2.5em 0;
  }

  .insights-prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-warm);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>
