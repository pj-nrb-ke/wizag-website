---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import PostCard from '../../components/insights/PostCard.astro';
import { getPublishedPosts, relatedPosts, slugify, formatDate, readingMinutes } from '../../lib/insights';
import '../../styles/prose.css';

/**
 * Insights article page. Draft posts build only in dev, so in production
 * getStaticPaths returns nothing until real articles exist. Each page passes
 * `noindex` while the section is dormant. Related posts and the category/tag
 * links are computed from the same shared helpers as the rest of the section.
 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts, 3) },
  }));
}

const { post, related } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const toc = headings.filter((h) => h.depth === 2);
const readMins = readingMinutes(post.body);
---

<BaseLayout title={`${data.title} — WIZAG Insights`} description={data.description} noindex>
  <article>
    <!-- HERO -->
    <header class="border-b border-grey-100 bg-warm">
      <Container width="narrow" class="py-10 md:py-14">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
            <li><a href="/" class="py-1 transition-colors hover:text-navy-700">Home</a></li>
            <li aria-hidden="true"><Icon name="chevron-down" size={13} class="-rotate-90" /></li>
            <li><a href="/insights" class="py-1 transition-colors hover:text-navy-700">Insights</a></li>
          </ol>
        </nav>

        <a
          href={`/insights/category/${slugify(data.category)}`}
          class="eyebrow text-orange-700 transition-colors hover:text-navy-700"
        >
          {data.category}
        </a>
        <h1 class="optical-left mt-4 text-[length:var(--text-5xl)] leading-[1.1] text-navy-700">
          {data.title}
        </h1>
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
          <span>{data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
          {
            data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(data.updatedDate)}</span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{readMins} min read</span>
          {
            data.draft && (
              <span class="rounded-[var(--radius-sm)] bg-orange-100 px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-[0.08em] text-orange-700">
                Draft
              </span>
            )
          }
        </div>
      </Container>
    </header>

    {
      data.heroImage && (
        <Container width="narrow" class="pt-10">
          <img
            src={data.heroImage}
            alt={data.heroImageAlt ?? ''}
            class="w-full rounded-[var(--radius-md)]"
          />
        </Container>
      )
    }

    <!-- BODY -->
    <Container width="narrow" class="py-10 md:py-14">
      {
        toc.length > 1 && (
          <nav
            aria-label="On this page"
            class="mb-10 rounded-[var(--radius-md)] border border-grey-100 bg-warm p-5"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">On this page</p>
            <ul class="mt-3 space-y-1.5">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="text-sm text-navy-700 underline-offset-2 transition-colors hover:text-orange-700 hover:underline"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <!-- FOOTER -->
      <footer class="mt-12 border-t border-grey-100 pt-6">
        {
          data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {data.tags.map((t) => (
                <li>
                  <a
                    href={`/insights/tag/${slugify(t)}`}
                    class="inline-block rounded-[var(--radius-sm)] bg-navy-50 px-2.5 py-1 text-xs font-medium text-navy-700 transition-colors hover:bg-navy-100 hover:text-orange-700"
                  >
                    #{t}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <a
          href="/insights"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-navy-700 transition-colors hover:text-orange-700"
        >
          <Icon name="arrow-right" size={15} class="rotate-180" />
          All Insights
        </a>
      </footer>
    </Container>
  </article>

  {
    related.length > 0 && (
      <Section tone="warm">
        <h2 class="mb-8 text-[length:var(--text-2xl)] leading-snug text-navy-700">Related reading</h2>
        <div class="grid gap-x-10 gap-y-10 md:grid-cols-3">
          {related.map((p, i) => (
            <PostCard post={p} index={i} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
