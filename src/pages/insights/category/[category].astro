---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Container from '../../../components/layout/Container.astro';
import Icon from '../../../components/ui/Icon.astro';
import PostCard from '../../../components/insights/PostCard.astro';
import { getPublishedPosts, collectTerms, slugify } from '../../../lib/insights';

/** One page per category. Empty in production (no published posts yet). */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTerms(posts, 'category').map((term) => ({
    params: { category: term.slug },
    props: { term, posts: posts.filter((p) => slugify(p.data.category) === term.slug) },
  }));
}

const { term, posts } = Astro.props;
---

<BaseLayout
  title={`${term.name} — WIZAG Insights`}
  description={`WIZAG Insights on ${term.name}.`}
  noindex
>
  <section class="border-b border-grey-100 bg-warm">
    <Container class="py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
          <li><a href="/" class="py-1 transition-colors hover:text-navy-700">Home</a></li>
          <li aria-hidden="true"><Icon name="chevron-down" size={13} class="-rotate-90" /></li>
          <li><a href="/insights" class="py-1 transition-colors hover:text-navy-700">Insights</a></li>
        </ol>
      </nav>
      <p class="eyebrow text-orange-700">Category</p>
      <h1 class="mt-3 text-[length:var(--text-5xl)] leading-[1.1] text-navy-700">{term.name}</h1>
      <p class="mt-3 text-ink-soft">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
    </Container>
  </section>

  <Section tone="paper">
    <div class="grid gap-x-10 gap-y-12 lg:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
    <a
      href="/insights"
      class="mt-12 inline-flex items-center gap-2 text-sm font-semibold text-navy-700 transition-colors hover:text-orange-700"
    >
      <Icon name="arrow-right" size={15} class="rotate-180" /> All Insights
    </a>
  </Section>
</BaseLayout>
