---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Container from '../../../components/layout/Container.astro';
import PostCard from '../../../components/insights/PostCard.astro';
import Pagination from '../../../components/insights/Pagination.astro';
import { getPublishedPosts, PAGE_SIZE } from '../../../lib/insights';

/**
 * Insights pagination, pages two onward (page one is /insights). Kept under
 * /insights/page/N so post URLs (/insights/[slug]) and page numbers never
 * collide. In production there are no draft posts, so this generates nothing.
 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);
  const paths = [];
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { page: String(n) },
      props: { pageNum: n, totalPages, posts: posts.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE) },
    });
  }
  return paths;
}

const { pageNum, totalPages, posts } = Astro.props;
---

<BaseLayout title={`Insights — page ${pageNum} — WIZAG`} description="More Insights articles." noindex>
  <section class="border-b border-grey-100 bg-warm">
    <Container class="py-10 md:py-12">
      <p class="eyebrow text-orange-700">Insights</p>
      <h1 class="mt-3 text-[length:var(--text-4xl)] leading-tight text-navy-700">More articles</h1>
    </Container>
  </section>

  <Section tone="paper">
    <div class="grid gap-x-10 gap-y-12 lg:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
    <Pagination current={pageNum} total={totalPages} />
  </Section>
</BaseLayout>
