---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { company } from '../data/navigation';

/**
 * Contact — "Book an Assessment".
 *
 * The form posts to /api/enquiry (a small Node service on the VPS, behind
 * Caddy — see server/enquiry/), which sends the enquiry through Brevo to
 * info@wizag.biz.
 *   · With JS: fetch → inline "thank you" (no page change).
 *   · Without JS: the form posts normally and the endpoint returns a
 *     thank-you page — so it never silently fails.
 * A honeypot field ("website") quietly drops bots. If the endpoint is ever
 * down, the visitor is pointed at the direct mailbox.
 */
const { address } = company;

const expectations = [
  'A 30-minute structured conversation, not a sales pitch',
  'We look at your systems, processes and reporting as they are today',
  'You get a plain view of where the value is — and where it is not',
  'No obligation to proceed',
];

const enquirySubject = 'Business technology assessment';
const inputClass =
  'rounded-[var(--radius-md)] border border-grey-300 bg-paper px-4 py-3 text-base text-ink ' +
  'placeholder:text-grey-500 transition-colors duration-[var(--duration-fast)] focus:border-navy-500';
---

<BaseLayout
  title="Contact"
  description="Book a business technology assessment with WIZAG. Valley View Office Park, Parklands, Nairobi."
>
  <PageHero
    title="Book a business technology assessment"
    lead="Tell us what you are trying to improve. We will look at your systems, operational bottlenecks and transformation priorities, and tell you plainly where we can help."
    eyebrow="Contact"
    crumbs={[{ label: 'Home', href: '/' }]}
  />

  <Section tone="paper">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow mb-4 text-ink-soft">What to expect</p>
        <ul>
          {
            expectations.map((item) => (
              <li class="flex items-start gap-3 border-t border-grey-300 py-4 text-[length:var(--text-lg)] text-ink">
                <Icon name="check" size={16} class="mt-1 shrink-0 text-orange-700" />
                {item}
              </li>
            ))
          }
        </ul>

        <p class="eyebrow mb-3 mt-10 text-ink-soft">Office</p>
        <address class="space-y-1 text-base not-italic leading-relaxed text-ink">
          <div class="font-semibold text-navy-700">{address.building}</div>
          <div>{address.unit}</div>
          <div>{address.street}</div>
          <div>{address.area}, {address.city}</div>
          <div>{address.country}</div>
        </address>
      </div>

      <div data-reveal data-reveal-delay="100">
        <form
          id="enquiry-form"
          action="/api/enquiry"
          method="post"
          class="rounded-[var(--radius-lg)] border border-grey-100 bg-warm p-7 sm:p-9"
        >
          <p class="eyebrow mb-2 text-ink-soft">Request your assessment</p>
          <p class="mb-6 max-w-[46ch] text-base leading-relaxed text-ink">
            A few details and we will come back with specifics — usually within one business day.
          </p>

          {/* Honeypot — hidden from people, tempting to bots. Leave it empty. */}
          <div class="hidden" aria-hidden="true">
            <label>Do not fill this in<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="grid gap-5">
            <div class="grid gap-1.5">
              <label for="f-name" class="text-sm font-semibold text-navy-700">Your name</label>
              <input id="f-name" name="name" type="text" required autocomplete="name" class={inputClass} />
            </div>

            <div class="grid gap-1.5">
              <label for="f-email" class="text-sm font-semibold text-navy-700">Work email</label>
              <input id="f-email" name="email" type="email" required autocomplete="email" class={inputClass} />
            </div>

            <div class="grid gap-1.5">
              <label for="f-company" class="text-sm font-semibold text-navy-700">
                Company <span class="font-normal text-ink-soft">(optional)</span>
              </label>
              <input id="f-company" name="company" type="text" autocomplete="organization" class={inputClass} />
            </div>

            <div class="grid gap-1.5">
              <label for="f-message" class="text-sm font-semibold text-navy-700">
                What would you like to improve?
              </label>
              <textarea
                id="f-message"
                name="message"
                rows="4"
                required
                placeholder="The systems you run and what is not working right now…"
                class={inputClass}></textarea>
            </div>
          </div>

          {/* reCAPTCHA renders here only if the server has a site key configured. */}
          <div id="recaptcha-slot" class="mt-6"></div>

          <div class="mt-7 flex flex-col items-start gap-4">
            <Button type="submit" variant="primary" size="large" arrow>Book my assessment</Button>
            <p
              id="enquiry-status"
              role="status"
              aria-live="polite"
              hidden
              class="text-sm font-semibold text-orange-700"
            >
            </p>
          </div>

          <p class="mt-6 border-t border-grey-300 pt-5 text-sm leading-relaxed text-ink-soft">
            We only use your details to respond to this enquiry. Prefer to write directly?{' '}
            <a
              href={`mailto:${company.email}?subject=${encodeURIComponent(enquirySubject)}`}
              class="font-semibold text-navy-700 underline underline-offset-4 hover:text-orange-700"
            >
              {company.email}
            </a>
          </p>
        </form>
      </div>
    </div>
  </Section>

  <script>
    // Progressive enhancement: submit via fetch, show an inline confirmation, and
    // require Google reCAPTCHA when the server has a site key configured.
    const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('enquiry-status');
    const submit = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const grc = () => (window as any).grecaptcha;
    let captchaWidgetId: number | null = null;

    const setStatus = (html: string) => {
      if (!statusEl) return;
      statusEl.hidden = false;
      statusEl.innerHTML = html;
    };
    const failMsg =
      'Sorry, that did not send. Please email ' +
      '<a class="underline" href="mailto:info@wizag.biz">info@wizag.biz</a>.';

    // Render the reCAPTCHA widget only if the server has a site key.
    (async () => {
      try {
        const cfg = await fetch('/api/config').then((r) => r.json());
        const siteKey = cfg?.recaptcha?.siteKey;
        if (!siteKey) return;
        (window as any).__wizagRecaptchaLoad = () => {
          captchaWidgetId = grc().render('recaptcha-slot', { sitekey: siteKey });
        };
        const s = document.createElement('script');
        s.src = 'https://www.google.com/recaptcha/api.js?onload=__wizagRecaptchaLoad&render=explicit';
        s.async = true;
        s.defer = true;
        document.head.appendChild(s);
      } catch {
        /* no captcha configured — the form still works */
      }
    })();

    form?.addEventListener('submit', async (event) => {
      if (!form.reportValidity()) return;
      event.preventDefault();
      const payload: Record<string, string> = Object.fromEntries(
        new FormData(form).entries() as any
      );

      if (captchaWidgetId !== null) {
        const token = grc().getResponse(captchaWidgetId);
        if (!token) {
          setStatus('Please complete the “I’m not a robot” check.');
          return;
        }
        payload['g-recaptcha-response'] = token;
      }

      if (submit) submit.disabled = true;
      setStatus('Sending…');
      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const out = await res.json().catch(() => ({ ok: false }));
        if (captchaWidgetId !== null) grc().reset(captchaWidgetId);
        if (res.ok && out.ok) {
          form.reset();
          setStatus('Thank you — we have it. We will be in touch, usually within one business day.');
        } else {
          setStatus(out.error ? out.error : failMsg);
        }
      } catch {
        setStatus(failMsg);
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
